Config = {
	StartDate = 20261001,
	EndDate = 20261031
}
Reward = {
	{ 1, 12216, 1 },
	{ 2, 12215, 1 },
	{ 3, 7059, 1 },
	{ 4, 7060, 1 },
	{ 5, 12216, 1 },
	{ 6, 12215, 1 },
	{ 7, 7059, 1 },
	{ 8, 7060, 1 },
	{ 9, 12216, 1 },
	{ 10, 12215, 1 },
	{ 11, 7059, 1 },
	{ 12, 7060, 1 },
	{ 13, 12216, 1 },
	{ 14, 12215, 1 },
	{ 15, 7619, 1 },
	{ 16, 7060, 1 },
	{ 17, 12216, 1 },
	{ 18, 12215, 1 },
	{ 19, 7059, 1 },
	{ 20, 7060, 1 }
}
function main()
	result, msg = InsertCheckAttendanceConfig(Config.EvendOnOff, Config.StartDate, Config.EndDate)
	if not result then
		return false, msg
	end
	for k, rewardtbl in pairs(Reward) do
		result, msg = InsertCheckAttendanceReward(rewardtbl[1], rewardtbl[2], rewardtbl[3])
		if not result then
			return false, msg
		end
	end
	return true, "success"
end
